<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#3b5bdb" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/styles.css" />
  <script src="/app.js"></script>
</head>
<body>
  <div class="top-bar">
    <a href="./contact">Kontakta oss</a>
    <a href="./about">Om oss</a>
    <a class="top-bar-cta" href="./donate">Ge en gåva</a>
  </div>
  <div class="church-bar" id="church-bar">
    <span class="church-bar-icon">&#x26EA;</span>
    <span class="church-bar-name">Laddar...</span>
    <span id="eth-date" style="font-size:11px;opacity:0.8;margin-left:auto"></span>
    <span class="church-bar-change">Byt kyrka &#x25BE;</span>
  </div>
  <div cass="church-modal" id="church-modal">
    <div class="church-modal-inner">
      <button class="church-modal-close">Stang &#x2715;</button>
      <h2>Valj kyrka</h2>
      <input type="text" class="church-search" placeholder="Sok..." />
      <button class="church-locate-btn">&#x1F4CD; Hitta nara mig</button>
      <div class="church-list"></div>
    </div>
  </div>
  <nav class="site-nav" id="site-nav">
    <a href="./">Hem</a>
    <a href="./intake">Bli medlem</a>
    <div class="nav-dropdown">
      <button class="nav-dropdown-toggle" onclick="this.parentElement.classList.toggle('open')">Fler &#x25BE;</button>
      <div class="nav-dropdown-menu">
        <a href="./funeral">Begravning</a>
        <a href="./baptism">Dop</a>
        <a href="./tezkar">Minnesbon</a>
        <a href="./library">Bibliotek</a>
        <a href="./support">Stod</a>
        <a href="./venue">Lokal</a>
      </div>
    </div>
    <a href="./live">Gudstjanst</a>
    <a href="./calendar">Kalender</a>
    <a href="./faq">FAQ</a>
  </nav>
  <main class="container">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="footer-grid">
      <div class="footer-col">
        <h3>Kontakt</h3>
        <p id="footer-church-name">Laddar...</p>
        <a href="./contact">Kontakta oss</a>
        <a id="footer-phone" href="#">Telefon</a>
        <p id="footer-org" style="font-size:11px;margin-top:4px"></p>
      </div>
      <div class="footer-col">
        <h3>Kalender</h3>
        <a href="./calendar">Kommande evenemang</a>
        <a href="./live">Gudstjanst live</a>
      </div>
      <div class="footer-col">
        <h3>Hitta snabbt</h3>
        <a href="./support">Stod</a>
        <a href="./intake">Bli medlem</a>
        <a href="./donate">Ge en gava</a>
        <a href="./faq">FAQ</a>
        <a href="./library">Bibliotek</a>
      </div>
      <div class="footer-col">
        <h3>Sociala kanaler</h3>
        <a href="https://t.me/kyrka_kanal" target="_blank">Telegram</a>
        <a href="./about">Om oss</a>
        <a href="./privacy">Integritetspolicy</a>
      </div>
    </div>
    <div class="footer-bottom">Inga kakor, ingen sparning.</div>
  </footer>
  <script>setupLangPills(); initChurchSelector(); initChurchData();</script>
</body>
</html>
