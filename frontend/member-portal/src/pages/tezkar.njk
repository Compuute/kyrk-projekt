    </div>

<script src="/qrcodegen.js"></script>
<script>
  (function () {
    var SWISH_NUMBER = '';
    var nameInput = document.getElementById('tezkar-name');
    var customInput = document.getElementById('custom-amount');
    var swishBtn = document.getElementById('swish-btn');
    var qrWrap = document.getElementById('swish-qr-wrap');
    var buttons = document.querySelectorAll('#amount-grid .amount-btn');
    var selectedAmount = 200;

    function message() {
      var n = (nameInput.value || '').trim();
      return n ? ('Tezkar — ' + n) : 'Tezkar minnesbon';
    }
    function isMobile() { return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent); }

    function updateSwishLink() {
      if (selectedAmount > 0 && SWISH_NUMBER) {
        if (isMobile()) {
          // phone: open the Swish app directly via the deep link
          swishBtn.style.display = '';
          swishBtn.textContent = 'Swish — ' + selectedAmount + ' kr';
          swishBtn.href = buildSwishLink(SWISH_NUMBER, selectedAmount, message());
          qrWrap.style.display = 'none';
        } else {
          // desktop: the deep link can't open an app — show a scannable QR
          swishBtn.style.display = 'none';
          if (window.renderSwishQr) {
            renderSwishQr(SWISH_NUMBER, selectedAmount, message(), document.getElementById('swish-qr'));
            qrWrap.style.display = 'block';
          }
        }
      } else {
        swishBtn.href = '#';
        qrWrap.style.display = 'none';
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        if (btn.dataset.amount === 'custom') {
          customInput.style.display = 'block';
          customInput.focus();
          selectedAmount = parseInt(customInput.value) || 0;
        } else {
          customInput.style.display = 'none';
          selectedAmount = parseInt(btn.dataset.amount);
        }
        updateSwishLink();
      });
    });
    customInput.addEventListener('input', function () {
      selectedAmount = parseInt(customInput.value) || 0;
      updateSwishLink();
    });
    nameInput.addEventListener('input', updateSwishLink);

    fetch(getContentUrl(), { credentials: 'omit', cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : {}; })
      .then(function (data) { SWISH_NUMBER = ((data && data.church) || {}).swish_number || ''; updateSwishLink(); })
      .catch(function () {});
  })();
</script>
