---
layout: base.njk
title: "Ge en gava"
breadcrumb: "Ge en gava"
---

<a href="/" class="back-link" id="back-link">
  <span class="sv">← Tillbaka</span>
  <span class="am" style="display:none;">← ተመለስ</span>
</a>

<div class="donate-card">
      <h1 id="donate-title">
        <span class="sv">Ge en gåva</span>
        <span class="am" style="display:none;">ስጦታ ይስጡ</span>
      </h1>
      <p id="donate-desc" style="color: #aaa; font-size: 14px;">
        <span class="sv">Ditt stöd gör vår verksamhet möjlig. Alla gåvor går till församlingens arbete.</span>
        <span class="am" style="display:none;">ድጋፍዎ ሥራችንን ይቻላል ያደርጋል። ሁሉም ስጦታዎች ለቤተ ክርስቲያኑ ሥራ ይውላሉ።</span>
      </p>

      <div class="amount-grid" id="amount-grid">
        <button class="amount-btn" data-amount="50">50 kr</button>
        <button class="amount-btn" data-amount="100">100 kr</button>
        <button class="amount-btn selected" data-amount="200">200 kr</button>
        <button class="amount-btn" data-amount="500">500 kr</button>
        <button class="amount-btn" data-amount="1000">1000 kr</button>
        <button class="amount-btn" data-amount="custom">
          <span class="sv">Annat</span>
          <span class="am" style="display:none;">ሌላ</span>
        </button>
      </div>

      <input type="number" class="amount-custom" id="custom-amount"
             placeholder="Ange belopp i SEK" style="display:none;" />

      <a class="swish-btn" id="swish-btn" href="#">
        <span class="sv">Swish — betala nu</span>
        <span class="am" style="display:none;">Swish — አሁን ይክፈሉ</span>
      </a>

      <div id="swish-qr-wrap" style="display:none;margin-top:14px;text-align:center">
        <div id="swish-qr" style="display:inline-block;background:#fff;padding:10px;border-radius:12px"></div>
        <p class="muted" style="font-size:13px;margin-top:8px">
          <span class="sv">På dator: skanna QR-koden med Swish-appen.</span>
          <span class="am" style="display:none;">በኮምፒውተር ላይ፦ QR ኮዱን በSwish መተግበሪያ ይቃኙ።</span>
        </p>
      </div>

      <div class="receipt-note" id="bank-transfer" style="display:none;">
        <strong><span class="sv">Banköverföring</span><span class="am" style="display:none;">በባንክ ማስተላለፍ</span></strong>
        <div id="bt-plusgiro" style="display:none;margin-top:6px;">PlusGiro: <strong id="bt-plusgiro-val"></strong></div>
        <div id="bt-iban" style="display:none;margin-top:4px;">IBAN: <strong id="bt-iban-val"></strong></div>
        <div id="bt-bic" style="display:none;margin-top:4px;">BIC/Swift: <strong id="bt-bic-val"></strong></div>
      </div>

      <div class="receipt-note" id="receipt-note">
        <span class="sv"><strong>Gåvokvitto:</strong> Ange din e-post nedan så skickar vi ett gåvokvitto när församlingen bekräftat din gåva. Kyrkan är godkänd gåvomottagare hos Skatteverket — för skattereduktion krävs även personnummer, kontakta församlingen.</span>
        <span class="am" style="display:none;"><strong>የስጦታ ደረሰኝ:</strong> ኢሜልዎን ከታች ያስገቡ፣ ስጦታዎ ሲረጋገጥ ደረሰኝ እንልክልዎታለን።</span>
        <br/><br/>
        Org.nr: 802492-9237 · Abune Tekle Haymanot Etiopiska Ortodoxa Tewahedo Kyrkan
      </div>

      <form id="receipt-form" style="margin-top: 12px;">
        <input type="email" id="receipt-email" required
               placeholder="din@epost.se"
               autocomplete="email" />
        <label style="display: block; font-size: 13px; margin: 8px 0;">
          <input type="checkbox" id="receipt-consent" required />
          <span class="sv">Jag samtycker till att min e-postadress används för att skicka gåvokvittot (GDPR).</span>
          <span class="am" style="display:none;">ኢሜሌ ለደረሰኝ መላኪያ እንዲውል እስማማለሁ።</span>
        </label>
        <button type="submit" class="method-btn" id="receipt-submit">
          <span class="sv">Begär gåvokvitto</span>
          <span class="am" style="display:none;">ደረሰኝ ይጠይቁ</span>
        </button>
        <p id="receipt-status" style="font-size: 13px; margin-top: 8px;" aria-live="polite"></p>
      </form>
    </div>

  <script src="/qrcodegen.js"></script>
  <script>
    var SWISH_NUMBER = '';

    // Load church config dynamically
    fetch(getContentUrl(), { credentials: 'omit', cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : {}; })
      .then(function (data) {
        var church = (data && data.church) || {};
        SWISH_NUMBER = church.swish_number || '';
        updateSwishLink();
        setBankTransfer(church);
      })
      .catch(function () {});

    // Render bank-transfer channels (PlusGiro / IBAN / BIC) when the church
    // config provides them. Data-driven and per-church; hidden if unset.
    function setBankTransfer(church) {
      var rows = [['bt-plusgiro', church.plusgiro_number], ['bt-iban', church.iban], ['bt-bic', church.bic]];
      var any = false;
      rows.forEach(function (row) {
        if (row[1]) {
          document.getElementById(row[0] + '-val').textContent = row[1];
          document.getElementById(row[0]).style.display = '';
          any = true;
        }
      });
      if (any) document.getElementById('bank-transfer').style.display = '';
    }

    var selectedAmount = 200;
    var buttons = document.querySelectorAll('.amount-btn');
    var customInput = document.getElementById('custom-amount');
    var swishBtn = document.getElementById('swish-btn');
    var qrWrap = document.getElementById('swish-qr-wrap');

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) { b.classList.remove('selected'); });
        btn.classList.add('selected');
        if (btn.dataset.amount === 'custom') {
          customInput.style.display = 'block';
          customInput.focus();
          selectedAmount = parseInt(customInput.value) || 0;
        } else {
          customInput.style.display = 'none';
          selectedAmount = parseInt(btn.dataset.amount);
        }
        updateSwishLink();
      });
    });

    customInput.addEventListener('input', function() {
      selectedAmount = parseInt(customInput.value) || 0;
      updateSwishLink();
    });

    function isMobile() {
      return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    }

    function updateSwishLink() {
      if (selectedAmount > 0 && SWISH_NUMBER) {
        if (isMobile()) {
          // phone: open the Swish app via the swish://payment deep link (buildSwishLink)
          swishBtn.style.display = '';
          swishBtn.href = buildSwishLink(SWISH_NUMBER, selectedAmount, 'Gåva till kyrkan');
          swishBtn.textContent = 'Swish — ' + selectedAmount + ' kr';
          swishBtn.onclick = null;
          qrWrap.style.display = 'none';
        } else {
          // desktop: the deep link can't open an app. Keep the button as the
          // amount label (non-clickable) and show a scannable QR below it.
          swishBtn.style.display = '';
          swishBtn.textContent = 'Swish — ' + selectedAmount + ' kr';
          swishBtn.href = '#';
          swishBtn.onclick = function (e) { e.preventDefault(); };
          if (window.renderSwishQr) {
            renderSwishQr(SWISH_NUMBER, selectedAmount, 'Gåva till kyrkan', document.getElementById('swish-qr'));
            qrWrap.style.display = 'block';
          }
        }
      } else {
        swishBtn.href = '#';
        swishBtn.textContent = 'Swish — välj belopp';
        swishBtn.onclick = null;
        qrWrap.style.display = 'none';
      }
    }

    updateSwishLink();

    var DONATIONS_URL = (window.API_BASE_URL || 'https://api.kyrka.compuute.net') + '/donations';

    document.getElementById('receipt-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var statusEl = document.getElementById('receipt-status');
      var submitBtn = document.getElementById('receipt-submit');
      if (!(selectedAmount > 0)) {
        statusEl.textContent = 'Välj belopp först.';
        return;
      }
      submitBtn.disabled = true;
      statusEl.textContent = 'Skickar…';
      fetch(DONATIONS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'omit',
        body: JSON.stringify({
          church_id: getSelectedChurch(),
          amount_sek: selectedAmount,
          method: 'swish',
          email: document.getElementById('receipt-email').value.trim(),
          gdpr_consent: document.getElementById('receipt-consent').checked
        })
      })
        .then(function (r) {
          if (r.status === 202) {
            document.getElementById('receipt-form').style.display = 'none';
            statusEl.textContent = '';
            var ok = document.createElement('p');
            ok.id = 'receipt-confirmed';
            ok.style.cssText = 'font-size: 13px; margin-top: 8px;';
            ok.textContent = 'Tack! Kvittot skickas till din e-post när församlingen bekräftat gåvan (normalt inom några dagar).';
            document.getElementById('receipt-note').after(ok);
          } else if (r.status === 429) {
            statusEl.textContent = 'För många försök — vänta en stund och försök igen.';
            submitBtn.disabled = false;
          } else {
            statusEl.textContent = 'Något gick fel — kontrollera e-postadressen och försök igen.';
            submitBtn.disabled = false;
          }
        })
        .catch(function () {
          statusEl.textContent = 'Kunde inte nå servern — försök igen senare.';
          submitBtn.disabled = false;
        });
    });
  </script>
