---
layout: base.njk
title: "Bli medlem"
activePage: "intake"
breadcrumb: "Bli medlem"
---



    <div class="form-card" id="intake-form-card">
      <h1>
        <span id="title-sv">Bli medlem</span>
        <span id="title-am" style="font-size: 18px; color: var(--muted, #666);"> / አባል ይሁኑ</span>
      </h1>
      <p class="subtitle" id="form-subtitle">
        Fyll i formuläret nedan. Vi kontaktar dig inom några dagar.
        <br/>
        ከዚህ በታች ያለውን ቅጽ ይሙሉ። በጥቂት ቀናት ውስጥ እናገኝዎታለን።
      </p>

      <form id="intake-form" novalidate>
        <input type="hidden" name="source" id="field-source" value="wifi" />
        <input type="hidden" name="church_id" id="field-church-id" value="nacka" />
        <input type="hidden" id="field-membership-type" value="individual" />
        <input type="hidden" id="field-monthly-fee" value="200" />
        <input type="hidden" name="action" id="field-action" value="register_and_switch" />

        <div class="form-group">
          <label for="action-select">
            Jag vill <span class="label-am">/ እፈልጋለሁ</span>
          </label>
          <select id="action-select" onchange="onActionChange()" style="width:100%;padding:12px;border:1px solid var(--border,#ccc);border-radius:8px;font-size:16px;">
            <option value="register_and_switch">Bli medlem + byta kyrkoskatt fr&#xE5;n Svenska kyrkan</option>
            <option value="register_only">Bara bli medlem (byt inte kyrkoskatt)</option>
            <option value="already_member">Redan medlem &#x2014; vill bara byta kyrkoskatt</option>
          </select>
        </div>

        <div class="membership-type" id="membership-section">
          <button type="button" class="type-btn selected" id="type-individual" onclick="selectType('individual')">
            <span class="price">200 kr</span>
            <span class="label">Enskild / ግለሰብ</span>
            <span class="label" style="font-size:11px;color:var(--muted,#666)">per m&#xE5;nad</span>
          </button>
          <button type="button" class="type-btn" id="type-family" onclick="selectType('family')">
            <span class="price">500 kr</span>
            <span class="label">Familj / ቤተሰብ</span>
            <span class="label" style="font-size:11px;color:var(--muted,#666)">per m&#xE5;nad</span>
          </button>
        </div>

        <div class="form-group">
          <label for="field-first-name">
            Förnamn <span class="label-am">/ ስም</span>
          </label>
          <input type="text" id="field-first-name" name="first_name" required autocomplete="given-name" />
        </div>

        <div class="form-group">
          <label for="field-last-name">
            Efternamn <span class="label-am">/ የአባት ስም</span>
          </label>
          <input type="text" id="field-last-name" name="last_name" required autocomplete="family-name" />
        </div>

        <div class="form-group">
          <label for="field-phone">
            Telefon <span class="label-am">/ ስልክ</span>
          </label>
          <input type="tel" id="field-phone" name="phone" required autocomplete="tel" inputmode="tel" />
        </div>

        <div class="form-group">
          <label for="field-email">
            E-post <span class="label-am">/ ኢሜይል</span>
          </label>
          <input type="email" id="field-email" name="email" autocomplete="email" inputmode="email" />
        </div>

        <div class="form-group">
          <label for="field-personal-number">
            Personnummer <span class="label-am">/ የግል ቁጥር</span>
          </label>
          <input type="text" id="field-personal-number" name="personal_number" placeholder="YYYYMMDD-XXXX" autocomplete="off" />
        </div>

        <div class="family-section" id="family-section">
          <strong>Familjemedlemmar / የቤተሰብ አባላት</strong>
          <p style="font-size:12px;color:var(--muted,#666);margin:4px 0 12px">
            Maka/make + barn under 18 &#xE5;r. / ባለቤት + ከ18 ዓመት በታች ልጆች።
          </p>
          <div id="family-members-list"></div>
          <button type="button" class="add-family-btn" id="add-family-btn" onclick="addFamilyMember()">
            + L&#xE4;gg till familjemedlem / + የቤተሰብ አባል ጨምር
          </button>
        </div>

        <div class="fee-summary" id="fee-summary">
          Månadsavgift / ወርሃዊ ክፍያ: <span class="fee-amount" id="fee-display">200 kr</span>
          <div style="font-size:12px;color:var(--muted,#666);margin-top:4px">
            Dras via autogiro efter första betalningen / ከመጀመሪያው ክፍያ በኋላ በautogiro ይቀነሳል
          </div>
        </div>

        <div class="gdpr-box" id="tax-consent-section" style="display:none;">
          <div class="gdpr-sv">
            <strong>Kyrkoavgift via Skatteverket:</strong> Jag samtycker till att min
            kyrkoavgift uppb&#xE4;rs av Skatteverket och tillfaller f&#xF6;rsamlingen
            (Lag 1999:291). Kr&#xE4;vs f&#xF6;r att kyrkoskatten ska g&#xE5; till v&#xE5;r
            kyrka i st&#xE4;llet f&#xF6;r Svenska kyrkan.
          </div>
          <div class="gdpr-am">
            <strong>የቤተ ክርስቲያን ክፍያ በ Skatteverket:</strong> የቤተ ክርስቲያን ክፍያዬ
            በግብር ስርዓት በኩል ተሰብስቦ ለቤተ ክርስቲያን እንዲሰጥ እስማማለሁ።
          </div>
          <input type="hidden" id="field-tax-consent" name="tax_consent" value="" />
          <button type="button" class="consent-btn" id="tax-consent-btn" onclick="toggleConsent('field-tax-consent','tax-consent-btn','tax-consent-box')">
            <span class="consent-box" id="tax-consent-box"></span>
            <span>Jag samtycker till kyrkoavgift via Skatteverket / እስማማለሁ</span>
          </button>
        </div>

        <div class="gdpr-box">
          <div class="gdpr-sv">
            <strong>GDPR-samtycke:</strong> Genom att skicka detta formulär samtycker du till att
            Abune Tekle Haymanot Etiopiska Ortodoxa Tewahedo Kyrkan lagrar dina personuppgifter
            i enlighet med GDPR. Dina uppgifter används enbart för medlemshantering och
            kommunikation. Du kan när som helst begära att dina uppgifter raderas genom att
            kontakta oss.
          </div>
          <div class="gdpr-am">
            <strong>GDPR ፈቃድ:</strong> ይህንን ቅጽ በመላክ አቡነ ተክለ ሃይማኖት ኢትዮጵያ ኦርቶዶክስ
            ተዋሕዶ ቤተ ክርስቲያን የግል መረጃዎን በ GDPR መሰረት እንዲያከማች ይስማማሉ። መረጃዎ
            ለአባልነት አስተዳደር እና ግንኙነት ብቻ ጥቅም ላይ ይውላል። በማንኛውም ጊዜ
            መረጃዎ እንዲሰረዝ መጠየቅ ይችላሉ።
          </div>
          <input type="hidden" id="field-gdpr-consent" name="gdpr_consent" value="" />
          <button type="button" class="consent-btn" id="consent-btn" onclick="toggleConsent()">
            <span class="consent-box" id="consent-box"></span>
            <span>Jag samtycker / እስማማለሁ</span>
          </button>
        </div>

        <div class="error-msg" id="error-msg"></div>

        <button type="submit" class="submit-btn" id="submit-btn">
          Skicka ansökan / ማመልከቻ ላክ
        </button>
      </form>
    </div>

    <div class="form-card success-msg" id="success-msg">
      <h2>Tack! Din ansökan behandlas.</h2>
      <p class="success-am">አመሰግናለሁ! ማመልከቻዎ በሂደት ላይ ነው።</p>
      <div id="payment-next-step" style="margin-top:16px;padding:16px;background:#f0f4ff;border-radius:10px;text-align:left;font-size:14px;">
        <strong>N&#xE4;sta steg — f&#xF6;rsta betalningen:</strong>
        <p style="margin:8px 0">Swisha <strong id="success-fee">200 kr</strong> till kyrkans Swish-nummer f&#xF6;r att aktivera ditt medlemskap. D&#xE4;refter kopplas autogiro automatiskt.</p>
        <a id="success-swish-link" class="swish-btn" href="#" style="display:inline-block;width:auto;padding:14px 28px;margin-top:8px;background:#5bbf2e;color:#fff;border-radius:10px;text-decoration:none;font-weight:700;">
          Swish — betala nu
        </a>
        <div id="autogiro-step" style="display:none;margin-top:16px;padding-top:12px;border-top:1px solid #d0d8f0;">
          <strong>Steg 2 — Autogiro:</strong>
          <p style="margin:6px 0">Signera med BankID s&#xE5; dras avgiften automatiskt varje m&#xE5;nad.</p>
          <a id="autogiro-link" class="swish-btn" href="#" target="_blank" style="display:inline-block;width:auto;padding:14px 28px;background:var(--accent,#3b5bdb);color:#fff;border-radius:10px;text-decoration:none;font-weight:700;">
            Starta autogiro (BankID)
          </a>
          <p style="margin-top:8px;font-size:12px;color:var(--muted,#666)">
            <strong>ደረጃ 2 — Autogiro:</strong> በ BankID ይፈርሙ ፣ ክፍያው በየወሩ በራስ-ሰር ይቀነሳል።
          </p>
        </div>
        <p style="margin-top:12px;font-size:12px;color:var(--muted,#666)">
          <strong>ቀጣይ ደረጃ:</strong> የመጀመሪያ ክፍያውን በ Swish ይክፈሉ። ከዚያ autogiro በራስ-ሰር ይጀምራል።
        </p>
      </div>
      <br/>
      <a href="./" class="back-link">&#x2190; Tillbaka till startsidan / ወደ መነሻ ገጽ ተመለስ</a>
    </div>
  <script>
  var churchConfig = {};
  var familyCount = 0;

  function selectType(type) {
    var indBtn = document.getElementById('type-individual');
    var famBtn = document.getElementById('type-family');
    var famSection = document.getElementById('family-section');
    var feeDisplay = document.getElementById('fee-display');
    var typeField = document.getElementById('field-membership-type');
    var feeField = document.getElementById('field-monthly-fee');

    var indFee = (churchConfig && churchConfig.membership_fee_individual) || 200;
    var famFee = (churchConfig && churchConfig.membership_fee_family) || 500;

    if (type === 'family') {
      famBtn.classList.add('selected');
      indBtn.classList.remove('selected');
      famSection.classList.add('visible');
      feeDisplay.textContent = famFee + ' kr';
      typeField.value = 'family';
      feeField.value = String(famFee);
      if (familyCount === 0) addFamilyMember();
    } else {
      indBtn.classList.add('selected');
      famBtn.classList.remove('selected');
      famSection.classList.remove('visible');
      feeDisplay.textContent = indFee + ' kr';
      typeField.value = 'individual';
      feeField.value = String(indFee);
    }
  }

  function addFamilyMember() {
    if (familyCount >= 4) return;
    familyCount++;
    var list = document.getElementById('family-members-list');
    var row = document.createElement('div');
    row.className = 'family-member-row';
    row.id = 'family-row-' + familyCount;
    row.innerHTML =
      '<input type="text" placeholder="Förnamn / ስም" data-field="first_name" />' +
      '<input type="text" placeholder="Efternamn / የአባት ስም" data-field="last_name" />' +
      '<select data-field="relation">' +
        '<option value="spouse">Maka/Make</option>' +
        '<option value="child">Barn</option>' +
      '</select>';
    list.appendChild(row);
  }

  function getFamilyMembers() {
    var rows = document.querySelectorAll('.family-member-row');
    var members = [];
    for (var i = 0; i < rows.length; i++) {
      var fn = rows[i].querySelector('[data-field="first_name"]').value.trim();
      var ln = rows[i].querySelector('[data-field="last_name"]').value.trim();
      var rel = rows[i].querySelector('[data-field="relation"]').value;
      if (fn && ln) {
        members.push({ first_name: fn, last_name: ln, personal_number: '', relation: rel });
      }
    }
    return members;
  }

  function onActionChange() {
    var action = document.getElementById('action-select').value;
    document.getElementById('field-action').value = action;

    var membershipSection = document.getElementById('membership-section');
    var feeSummary = document.getElementById('fee-summary');
    var familySection = document.getElementById('family-section');
    var taxSection = document.getElementById('tax-consent-section');

    var alreadyMember = action === 'already_member';
    var wantsSwitch = action === 'already_member' || action === 'register_and_switch';

    // Existing members switching tax pay no new membership fee — hide the
    // fee/family selection entirely and zero the fee.
    membershipSection.style.display = alreadyMember ? 'none' : 'flex';
    feeSummary.style.display = alreadyMember ? 'none' : 'block';
    if (alreadyMember) {
      familySection.classList.remove('visible');
      document.getElementById('field-membership-type').value = 'individual';
      document.getElementById('field-monthly-fee').value = '0';
    } else {
      // Restore the currently-selected membership type's fee.
      selectType(document.getElementById('field-membership-type').value || 'individual');
    }

    // Church-tax consent only makes sense (and is required) when switching.
    taxSection.style.display = wantsSwitch ? 'block' : 'none';
    if (!wantsSwitch) {
      document.getElementById('field-tax-consent').value = '';
      document.getElementById('tax-consent-btn').classList.remove('checked');
      document.getElementById('tax-consent-box').textContent = '';
    }
  }
  </script>

  <script>
    (function () {
      // Read URL params for hidden fields
      var params = new URLSearchParams(window.location.search);
      var source = params.get('source');
      if (source) {
        document.getElementById('field-source').value = source;
      }
      var church = params.get('church');
      if (church) {
        document.getElementById('field-church-id').value = church;
      }

      var API_URL = 'https://membership-intake-479770870521.europe-north1.run.app/intake';

      document.getElementById('field-church-id').value = getSelectedChurch();

      fetch(getContentUrl(), { credentials: 'omit', cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : {}; })
        .then(function (data) {
          churchConfig = (data && data.church) || {};
          var indFee = churchConfig.membership_fee_individual || 200;
          var famFee = churchConfig.membership_fee_family || 500;
          document.getElementById('type-individual').querySelector('.price').textContent = indFee + ' kr';
          document.getElementById('type-family').querySelector('.price').textContent = famFee + ' kr';
          document.getElementById('field-monthly-fee').value = String(indFee);
          document.getElementById('fee-display').textContent = indFee + ' kr';
        })
        .catch(function () {});

      // Form submission
      var form = document.getElementById('intake-form');
      var formCard = document.getElementById('intake-form-card');
      var successMsg = document.getElementById('success-msg');
      var errorMsg = document.getElementById('error-msg');
      var submitBtn = document.getElementById('submit-btn');

      // Apply the default action's visibility (default = register_and_switch,
      // so the church-tax consent section is shown on load).
      onActionChange();

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errorMsg.style.display = 'none';

        var firstName = document.getElementById('field-first-name').value;
        var lastName = document.getElementById('field-last-name').value;
        var phone = document.getElementById('field-phone').value;
        var pnr = document.getElementById('field-personal-number').value;

        if (!validateName(firstName)) {
          errorMsg.textContent = 'Ogiltigt förnamn (min 2 tecken, inga siffror). / ልክ ያልሆነ ስም (ቢያንስ 2 ፊደል)።';
          errorMsg.style.display = 'block';
          return;
        }
        if (!validateName(lastName)) {
          errorMsg.textContent = 'Ogiltigt efternamn (min 2 tecken, inga siffror). / ልክ ያልሆነ የአባት ስም።';
          errorMsg.style.display = 'block';
          return;
        }
        if (!validatePhone(phone)) {
          errorMsg.textContent = 'Ogiltigt telefonnummer (07X-XXX XX XX). / ልክ ያልሆነ ስልክ ቁጥር።';
          errorMsg.style.display = 'block';
          return;
        }
        if (pnr && !validatePersonnummer(pnr)) {
          errorMsg.textContent = 'Ogiltigt personnummer. Kontrollera format (YYYYMMDD-XXXX). / ልክ ያልሆነ የግል ቁጥር።';
          errorMsg.style.display = 'block';
          return;
        }
        if (document.getElementById('field-gdpr-consent').value !== 'true') {
          errorMsg.textContent = 'Du måste ge ditt samtycke. / ፈቃድዎን መስጠት አለbዎት።';
          errorMsg.style.display = 'block';
          return;
        }

        var action = document.getElementById('field-action').value;
        var taxConsent = document.getElementById('field-tax-consent').value === 'true';
        var wantsSwitch = action === 'already_member' || action === 'register_and_switch';

        // Church-tax switch requires a personnummer (för Skatteverket) and the
        // explicit avgiftshjälp-consent (Lag 1999:291).
        if (wantsSwitch && !pnr) {
          errorMsg.textContent = 'Personnummer krävs för att byta kyrkoskatt. / ለቤተ ክርስቲያን ግብር ለመቀየር የግል ቁጥር ያስፈልጋል።';
          errorMsg.style.display = 'block';
          return;
        }
        if (wantsSwitch && !taxConsent) {
          errorMsg.textContent = 'Du måste samtycka till att kyrkoavgiften uppbärs via Skatteverket. / በግብር ስርዓት ለመሰብሰብ መስማማት አለብዎት።';
          errorMsg.style.display = 'block';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Skickar... / በመላክ ላይ...';

        var membershipType = document.getElementById('field-membership-type').value;
        var familyMembers = membershipType === 'family' ? getFamilyMembers() : [];

        if (membershipType === 'family' && familyMembers.length === 0) {
          errorMsg.textContent = 'Lägg till minst en familjemedlem. / ቢያንስ አንድ የቤተሰብ አባል ያክሉ።';
          errorMsg.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = 'Skicka ansökan / ማመልከቻ ላክ';
          return;
        }

        var payload = {
          first_name: document.getElementById('field-first-name').value,
          last_name: document.getElementById('field-last-name').value,
          phone: document.getElementById('field-phone').value,
          email: document.getElementById('field-email').value,
          personal_number: document.getElementById('field-personal-number').value,
          gdpr_consent: document.getElementById('field-gdpr-consent').value === 'true',
          consent_timestamp: new Date().toISOString(),
          source: document.getElementById('field-source').value,
          church_id: document.getElementById('field-church-id').value,
          membership_type: membershipType,
          monthly_fee_sek: parseInt(document.getElementById('field-monthly-fee').value),
          action: action,
          tax_consent: taxConsent,
          family_members: familyMembers
        };

        fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'omit',
          body: JSON.stringify(payload)
        })
          .then(function (r) {
            if (r.status === 202 || r.status === 201) {
              formCard.style.display = 'none';
              successMsg.style.display = 'block';
              // "Redan medlem — byt bara kyrkoskatt": no new membership fee or
              // Swish/autogiro step — the church files the Skatteverket consent.
              if (action === 'already_member') {
                document.getElementById('payment-next-step').style.display = 'none';
                return;
              }
              var fee = parseInt(document.getElementById('field-monthly-fee').value);
              document.getElementById('success-fee').textContent = fee + ' kr';
              var swishLink = document.getElementById('success-swish-link');
              var swishNr = (churchConfig && churchConfig.swish_number) || '';
              if (swishNr) {
                swishLink.href = buildSwishLink(swishNr, fee, 'Medlemsavgift');
                swishLink.textContent = 'Swish — ' + fee + ' kr';
              } else {
                swishLink.style.display = 'none';
              }
              var agFormUrl = (churchConfig && churchConfig.autogiro_form_url) || '';
              if (agFormUrl) {
                document.getElementById('autogiro-step').style.display = 'block';
                document.getElementById('autogiro-link').href = agFormUrl;
              }
              return;
            }
            if (r.status === 409) {
              throw { userMsg: 'Du är redan registrerad. / እርስዎ ቀድሞ ተመዝግበዋል።' };
            }
            if (r.status === 422) {
              return r.json().then(function (data) {
                var msg = 'Kontrollera dina uppgifter. / መረጃዎን ያረጋግጡ።';
                if (typeof data.detail === 'string') {
                  msg = data.detail;
                } else if (Array.isArray(data.detail) && data.detail.length > 0) {
                  msg = data.detail.map(function (e) { return e.msg || ''; }).join('. ');
                }
                throw { userMsg: msg };
              });
            }
            throw { userMsg: 'Tekniskt fel. Försök igen. / የቴክኒክ ችግር። እንደገና ሞክር።' };
          })
          .catch(function (err) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Skicka ansökan / ማመልከቻ ላክ';
            if (err && err.userMsg) {
              errorMsg.textContent = err.userMsg;
            } else {
              errorMsg.textContent = 'Kunde inte ansluta till servern. Försök igen senare. / ከሰርቨር ጋር መገናኘት አልተቻለም።';
            }
            errorMsg.style.display = 'block';
          });
      });
    })();
  </script>
