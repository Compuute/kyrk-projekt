    <h1 id="live-title">Gudstjänst live</h1>
    <p id="live-subtitle" style="color:#aaa;font-size:14px;margin-bottom:16px;">
      Följ vår gudstjänst direkt. Välkommen att be med oss.
    </p>

    <!-- Video embed — populated by JS from content.json -->
    <div id="video-area">
      <div class="no-stream" id="no-stream">
        <div>
          <p id="no-stream-text" style="font-size:16px;"><span class="sv">Ingen livestream just nu</span><span class="am" style="display:none">አሁን ቀጥታ ስርጭት የለም</span></p>
          <p style="font-size:13px;margin-top:8px;" id="check-schedule-text"><span class="sv">Se schemat nedan för kommande gudstjänster</span><span class="am" style="display:none">ለቀጣይ ቅዳሴዎች ከዚህ በታች ያለውን መርሃ ግብር ይመልከቱ</span></p>
        </div>
      </div>
    </div>

    <!-- Weekly schedule -->
    <div class="schedule-card">
      <h2 id="schedule-title"><span class="sv">Gudstjänstschema</span><span class="am" style="display:none">የቅዳሴ መርሃ ግብር</span></h2>
      <div id="schedule-list">
        <div class="schedule-item"><span>Söndag</span><span>11:00 — ቅዳሴ / Gudstjänst</span></div>
        <div class="schedule-item"><span>Onsdag</span><span>18:00 — ጸሎት / Bön</span></div>
        <div class="schedule-item"><span>Lördag</span><span>16:00 — የሰንበት ት/ት / Söndagsskola</span></div>
      </div>
    </div>

    <!-- Call-to-action buttons -->
    <div class="cta-row">
      <a class="cta-btn cta-primary" href="./intake" id="cta-member">Bli medlem / አባል ይሁኑ</a>
      <a class="cta-btn cta-secondary" href="./donate" id="cta-donate">Ge en gåva / ስጦታ ይስጡ</a>
    </div>

    <p style="color:#666;font-size:12px;text-align:center;margin-top:24px;" id="footer-note">
      Ingen inspelning sparas av ditt besök. Inga spårningskakor.
    </p>

    <script>
      (function() {
        loadChurchContent(function(config) {
          if (!config) return;

          // If church has a YouTube channel, show the embed
          var channelId = config.church && config.church.youtube_channel_id;
          if (channelId) {
            var videoArea = document.getElementById('video-area');
            videoArea.innerHTML =
              '<div class="video-container">' +
              '<iframe src="https://www.youtube.com/embed/live_stream?channel=' + channelId + '&autoplay=1" ' +
              'allow="autoplay; encrypted-media" allowfullscreen></iframe>' +
              '</div>' +
              '<p style="font-size:12px;color:#888;text-align:center;">' +
              'Om streamen inte visas — <a href="https://www.youtube.com/channel/' + channelId + '/live" ' +
              'target="_blank" style="color:var(--accent)">öppna på YouTube</a></p>';
          }

          // Update church name in title if available
          var lang = (navigator.language || 'sv').slice(0,2) === 'am' ? 'am' : 'sv';
          if (config.church && config.church.name) {
            document.title = (lang === 'am' ? 'ቀጥታ — ' : 'Live — ') +
              (config.church.name[lang] || config.church.name.sv || '');
          }

          // Amharic translations
          if (lang === 'am') {
            document.getElementById('live-title').textContent = 'የቀጥታ ቅዳሴ';
            document.getElementById('live-subtitle').textContent = 'ቅዳሴያችንን በቀጥታ ይከታተሉ። ከእኛ ጋር ይጸልዩ።';
            document.getElementById('back-link').textContent = '← ተመለስ';
            document.getElementById('no-stream-text').textContent = 'አሁን ቀጥታ ስርጭት የለም';
            document.getElementById('check-schedule-text').textContent = 'ለመጪ ቅዳሴዎች ከታች ያለውን መርሐ ግብር ይመልከቱ';
            document.getElementById('schedule-title').textContent = 'የቅዳሴ መርሐ ግብር';
            document.getElementById('footer-note').textContent = 'ምንም ቀረጻ አይቀመጥም። ኩኪዎች የሉም።';
          }
        });
      })();
    </script>
