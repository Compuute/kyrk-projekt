      <div id="schedule-list">
        <div class="schedule-item"><span>Söndag</span><span>11:00 — ቅዳሴ / Gudstjänst</span></div>
        <div class="schedule-item"><span>Onsdag</span><span>18:00 — ጸሎት / Bön</span></div>
        <div class="schedule-item"><span>Lördag</span><span>16:00 — የሰንበት ት/ት / Söndagsskola</span></div>
