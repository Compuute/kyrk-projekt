    <p style="color:#666;font-size:12px;text-align:center;margin-top:24px;" id="footer-note">
      Ingen inspelning sparas av ditt besök. Inga spårningskakor.
    </p>

    <script>
      (function() {
        // Time-gated, privacy-first livestream.
        //   - Inside a scheduled service window (church.live_schedule, evaluated
        //     in Europe/Stockholm) we embed the channel's current live stream
        //     via youtube-nocookie.com.
        //   - Outside the window NO YouTube iframe is loaded at all — a clean
        //     card is shown instead. So casual visitors never see YouTube's
        //     "An error occurred" box AND no YouTube cookies are set off-hours,
        //     which keeps the site's no-tracking promise.
        // We never embed a single video id — it would go stale after a stream.
        var DAY = { sun: 0, mon: 1, tue: 2, wed: 3, thu: 4, fri: 5, sat: 6 };
        var PREROLL_MIN = 15; // show the player up to 15 min before start

        function stockholmNow() {
          var parts = new Intl.DateTimeFormat('en-GB', {
            timeZone: 'Europe/Stockholm', weekday: 'short',
            hour: '2-digit', minute: '2-digit', hour12: false
          }).formatToParts(new Date());
          var m = {};
          parts.forEach(function(p) { m[p.type] = p.value; });
          var wd = (m.weekday || 'Sun').toLowerCase().slice(0, 3);
          return { day: DAY[wd], minutes: parseInt(m.hour, 10) * 60 + parseInt(m.minute, 10) };
        }

        function isLiveNow(schedule) {
          if (!schedule || !schedule.length) return false;
          var now = stockholmNow();
          for (var i = 0; i < schedule.length; i++) {
            var s = schedule[i] || {};
            if (DAY[(s.day || '').toLowerCase()] !== now.day) continue;
            var hm = (s.start || '').split(':');
            var start = parseInt(hm[0], 10) * 60 + parseInt(hm[1] || '0', 10);
            var dur = parseInt(s.duration_min, 10) || 120;
            if (now.minutes >= start - PREROLL_MIN && now.minutes < start + dur) return true;
          }
          return false;
        }

        loadChurchContent(function(config) {
          if (!config) return;
          var church = config.church || {};
          var channelId = church.youtube_channel_id;
          var handle = (church.youtube_handle || '').replace(/^@/, '');
          var schedule = church.live_schedule || [];
          var videoArea = document.getElementById('video-area');
          var lang = (navigator.language || 'sv').slice(0, 2) === 'am' ? 'am' : 'sv';

          var watchUrl = channelId
            ? 'https://www.youtube.com/channel/' + channelId + '/live'
            : (handle ? 'https://www.youtube.com/@' + handle + '/live' : '');

          if (channelId && isLiveNow(schedule)) {
            // Within a service window → embed (privacy: nocookie domain).
            videoArea.innerHTML =
              '<div class="video-container">' +
              '<iframe src="https://www.youtube-nocookie.com/embed/live_stream?channel=' + channelId + '&autoplay=1" ' +
              'allow="autoplay; encrypted-media" allowfullscreen></iframe>' +
              '</div>' +
              '<p style="font-size:12px;color:#888;text-align:center;">' +
              (lang === 'am' ? 'ካልታየ' : 'Om streamen inte visas') +
              ' — <a href="' + watchUrl + '" target="_blank" rel="noopener" ' +
              'style="color:var(--accent)">' + (lang === 'am' ? 'በYouTube ይክፈቱ' : 'öppna på YouTube') + '</a></p>';
          } else if (channelId || handle) {
            // Off-hours → clean card, no iframe, no YouTube connection.
            videoArea.innerHTML =
              '<div class="no-stream"><div>' +
              '<p style="font-size:16px;">' +
              (lang === 'am' ? 'አሁን ቀጥታ ስርጭት የለም' : 'Ingen pågående sändning just nu') + '</p>' +
              '<p style="font-size:13px;margin-top:8px;">' +
              (lang === 'am' ? 'የሚቀጥሉ ቅዳሴዎችን ከታች ይመልከቱ' : 'Se schemat nedan för kommande gudstjänster') + '</p>' +
              (watchUrl
                ? '<p style="font-size:13px;margin-top:10px;"><a href="' + watchUrl + '" target="_blank" rel="noopener" ' +
                  'style="color:var(--accent)">' + (lang === 'am' ? 'ቻናሉን በYouTube ይክፈቱ' : 'öppna kanalen på YouTube') + '</a></p>'
                : '') +
              '</div></div>';
          }
          // else: nothing configured → keep the static "Ingen livestream just nu"

          // Church name in title
          if (church.name) {
            document.title = (lang === 'am' ? 'ቀጥታ — ' : 'Live — ') +
              (church.name[lang] || church.name.sv || '');
          }

          // Amharic translations (guarded — some nodes may be replaced above)
          if (lang === 'am') {
            var set = function(id, txt) { var el = document.getElementById(id); if (el) el.textContent = txt; };
            set('live-title', 'የቀጥታ ቅዳሴ');
            set('live-subtitle', 'ቅዳሴያችንን በቀጥታ ይከታተሉ። ከእኛ ጋር ይጸልዩ።');
            set('back-link', '← ተመለስ');
            set('check-schedule-text', 'ለመጪ ቅዳሴዎች ከታች ያለውን መርሐ ግብር ይመልከቱ');
            set('schedule-title', 'የቅዳሴ መርሐ ግብር');
            set('footer-note', 'ምንም ቀረጻ አይቀመጥም። ኩኪዎች የሉም።');
          }
        });
      })();
    </script>
