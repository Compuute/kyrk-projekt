breadcrumb: "Kontakt"
---

<h1><span class="sv">Kontakta oss</span><span class="am" style="display:none">ያግኙን</span></h1>

    <div id="contact-content">
      <div class="contact-card">
        <h3>Adress / &#x12A0;&#x12F5;&#x122B;&#x123B;</h3>
        <div class="contact-row">
          <div class="contact-icon">&#x1F4CD;</div>
          <div id="contact-address">Laddar...</div>
        </div>
      </div>

      <div class="contact-card" id="phone-card" style="display:none">
        <h3>Telefon / &#x1235;&#x120D;&#x12AD;</h3>
        <div class="contact-row">
          <div class="contact-icon">&#x1F4DE;</div>
          <div id="contact-phone"></div>
        </div>
      </div>

      <div class="contact-card" id="email-card" style="display:none">
        <h3>E-post / &#x12A2;&#x121C;&#x12ED;&#x120D;</h3>
        <div class="contact-row">
          <div class="contact-icon">&#x2709;</div>
          <div id="contact-email"></div>
        </div>
      </div>

      <div class="contact-card" id="org-card" style="display:none">
        <h3>Organisation / &#x12F5;&#x122D;&#x1305;&#x1275;</h3>
        <div id="contact-org"></div>
      </div>
    </div>

  <script>
    function renderContactInfo(church) {
      var addressEl = document.getElementById('contact-address');
      if (!church) {
        addressEl.textContent = 'Kontaktuppgifter saknas. / መረጃ አልተገኘም።';
        return;
      }
      addressEl.textContent = church.address || 'Adress saknas. / አድራሻ አልተገኘም።';

      if (church.phone) {
        var phoneLink = document.createElement('a');
        phoneLink.href = 'tel:' + church.phone.replace(/\s/g, '');
        phoneLink.textContent = church.phone;
        document.getElementById('contact-phone').appendChild(phoneLink);
        document.getElementById('phone-card').style.display = '';
      }
      if (church.email) {
        var emailLink = document.createElement('a');
        emailLink.href = 'mailto:' + church.email;
        emailLink.textContent = church.email;
        document.getElementById('contact-email').appendChild(emailLink);
        document.getElementById('email-card').style.display = '';
      }
      if (church.org_number) {
        document.getElementById('contact-org').textContent = 'Org.nr: ' + church.org_number;
        document.getElementById('org-card').style.display = '';
      }
    }

    function initContactPage() {
      fetch('./churches.json', { credentials: 'omit' })
        .then(function (r) { return r.ok ? r.json() : { churches: [] }; })
        .then(function (data) {
          var churchId = getSelectedChurch();
          var churches = data.churches || [];
          var church = null;
          for (var i = 0; i < churches.length; i++) {
            if (churches[i].id === churchId) { church = churches[i]; break; }
          }
          renderContactInfo(church);
        })
        .catch(function () {
          document.getElementById('contact-address').textContent =
            'Kunde inte ladda kontaktuppgifter. / መረጃ መጫን አልተቻለም።';
        });
    }
    initContactPage();
  </script>
